{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vetch",
  "version": "0.1.1",
  "identifier": "app.vetch.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:vite",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "Vetch",
        "width": 1120,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560,
        "maxWidth": 1280,
        "maxHeight": 860,
        "center": true,
        "decorations": false,
        "maximizable": false,
        "resizable": true,
        "transparent": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Download video and audio with yt-dlp",
    "longDescription": "Vetch is a focused, cross-platform media downloader powered by Rust, Tauri and yt-dlp.",
    "resources": [
      "resources/bin/yt-dlp*",
      "resources/bin/ffmpeg*",
      "resources/bin/deno*",
      "../THIRD_PARTY_NOTICES.md",
      "../LICENSES/*",
      "../third-party-binaries.json"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
