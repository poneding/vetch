{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the Vetch main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "allow-get-settings",
    "allow-save-settings",
    "allow-get-history",
    "allow-probe-url",
    "allow-start-download",
    "allow-retry-download",
    "allow-cancel-download",
    "allow-pause-download",
    "allow-resume-download",
    "allow-rename-download-title",
    "allow-rename-playlist",
    "allow-remove-history-item",
    "allow-clear-finished-history",
    "allow-delete-downloaded-file",
    "allow-get-runtime-info",
    "allow-open-downloaded-file",
    "allow-reveal-downloaded-file",
    "allow-open-media-browser",
    "allow-get-browser-state",
    "clipboard-manager:allow-read-text",
    "dialog:allow-open",
    "notification:default",
    "opener:default",
    "process:allow-restart",
    "updater:default"
  ]
}
